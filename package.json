{
  "name": "cosmoz",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo test",
    "api:dev": "pnpm --filter @cosmoz/api dev",
    "web:dev": "pnpm --filter web dev",
    "market:dev": "cd mini-services/market-service && bun run dev",
    "market:test": "cd mini-services/market-service && bun test"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
