# COSMOZ web — environment template (copy to .env.local)

# When "true", the MSW mock backend intercepts all API calls in the browser.
# Set to "false" (or remove) once the real NestJS API is wired up.
NEXT_PUBLIC_API_MOCKED=true

# Base URL of the COSMOZ API. Leave unset for same-origin "/api" (mocked dev).
# When pointing at the real NestJS API, include the version segment: the API
# serves routes under the global prefix "api" + URI version "1" → "/api/v1".
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
