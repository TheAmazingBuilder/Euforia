# COSMOZ web — environment template (copy to .env.local)

# ── API mode ─────────────────────────────────────────────────────────────────
# Default: MSW mock backend intercepts all API calls in the browser.
#
# LIVE BRIDGE (Phase C): set NEXT_PUBLIC_API_LIVE=true to serve the real
# NestJS backend instead. Requests then go to the SAME origin under /api/v1
# and next.config.ts proxies them to the API (API_PROXY_TARGET, default
# http://localhost:4000) — no CORS, HttpOnly refresh cookie stays first-party.
NEXT_PUBLIC_API_MOCKED=true
# NEXT_PUBLIC_API_LIVE=true

# Direct cross-origin override (wins over the live bridge default). Include
# the version segment: the API serves routes under the global prefix "api" +
# URI version "1" → "/api/v1". Requires CORS + credentials on the API side.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Proxy target for the live bridge (server-side, evaluated at start).
# API_PROXY_TARGET=http://localhost:4000
