# COSMOZ web — environment template (copy to .env.local)

# ── API mode ─────────────────────────────────────────────────────────────────
# Canonical mode check: apps/web/src/lib/api/mode.ts (single source of truth).
#
#   The MSW mock layer has been REMOVED from the project: the web app always
#   talks to the real NestJS backend. NEXT_PUBLIC_API_MOCKED is ignored.
#
# In real mode requests go to the SAME origin under /api/v1 and
# next.config.ts proxies them to the API (API_PROXY_TARGET, default
# http://localhost:4000) — no CORS, HttpOnly refresh cookie stays
# first-party.

# Direct cross-origin override (wins over the same-origin default). Include
# the version segment: the API serves routes under the global prefix "api" +
# URI version "1" → "/api/v1". Requires CORS + credentials on the API side.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Proxy target for real mode (server-side, evaluated at start).
# API_PROXY_TARGET=http://localhost:4000
