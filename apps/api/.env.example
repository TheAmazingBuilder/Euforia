# COSMOZ API — environment template (copy to .env)
# NEVER commit real secrets. This file documents the validated contract.

# ── Application ──────────────────────────────────────────────────────────────
# test | development | production
NODE_ENV=development
# Port the API listens on (web .env.example suggests http://localhost:4000)
PORT=4000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local dev default: embedded dev database managed by `pnpm db:up` (port 5433).
# In production, supply a real connection string with credentials. The password
# MUST NOT be committed anywhere.
DATABASE_URL=postgresql://cosmoz@127.0.0.1:5433/cosmoz

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of origins. In production this variable is
# REQUIRED and "*" is rejected. Development default: the Next.js dev server.
# Multiple origins example: http://localhost:3000,https://app.cosmoz.app
CORS_ORIGINS=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug

# ── Security / requests ──────────────────────────────────────────────────────
# Max JSON body size in bytes (default 1 MiB).
BODY_LIMIT_BYTES=1048576
# Set true ONLY when the API runs behind a trusted reverse proxy, so rate
# limiting and client IPs use X-Forwarded-For instead of the proxy address.
TRUST_PROXY=false

# ── Rate limiting (global defaults — policies are refined per route later) ──
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120

# ── External services (optional — not wired in Foundation) ──────────────────
# Market data sidecar (Bun service on :3003 in dev). Format-validated when set.
# MARKET_SERVICE_URL=http://localhost:3003

# ── Authentication (PLACEHOLDER — Phase 2 will validate these) ──────────────
# Deliberately NOT validated in Foundation: do not add real secrets here yet.
# AUTH_JWT_SECRET=
# AUTH_JWT_ACCESS_TTL_SECONDS=900
