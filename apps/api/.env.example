# COSMOZ API — environment template (copy to .env)
# NEVER commit real secrets. This file documents the validated contract.

# ── Application ──────────────────────────────────────────────────────────────
# test | development | production
NODE_ENV=development
# Port the API listens on (web .env.example suggests http://localhost:4000)
PORT=4000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Point this at YOUR OWN local PostgreSQL server (default port 5432) or a
# managed instance. The project no longer ships an embedded dev database.
# Create the dev DB first, e.g.: createdb cosmoz (or via pgAdmin).
# In production, supply a real connection string with credentials. The password
# MUST NOT be committed anywhere.
#DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cosmoz

# DATABASE_URL_TEST=postgresql://USER:PASSWORD@127.0.0.1:5432/euforia_test?schema=public


# Optional: dedicated database URL used by the API test suite (vitest
# global-setup). Defaults to postgresql://postgres@127.0.0.1:5432/cosmoz_test.
# DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:5432/cosmoz_test

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of origins. In production this variable is
# REQUIRED and "*" is rejected. Development default: the Next.js dev server.
# Multiple origins example: http://localhost:3000,https://app.cosmoz.app
CORS_ORIGINS=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug

# ── Security / requests ──────────────────────────────────────────────────────
# Max JSON body size in bytes (default 1 MiB).
BODY_LIMIT_BYTES=9437184
# Set true ONLY when the API runs behind a trusted reverse proxy, so rate
# limiting and client IPs use X-Forwarded-For instead of the proxy address.
TRUST_PROXY=false

# ── Rate limiting (global defaults — policies are refined per route later) ──
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120

# ── External services (optional — not wired in Foundation) ──────────────────
# Market data sidecar (Bun service on :3003 in dev). Format-validated when set.
# MARKET_SERVICE_URL=http://localhost:3003

# ── Authentication (PLACEHOLDER — Phase 2 will validate these) ──────────────
# Deliberately NOT validated in Foundation: do not add real secrets here yet.
# AUTH_JWT_SECRET=
# AUTH_JWT_ACCESS_TTL_SECONDS=900

# ── Authentication (Identity phase — REQUIRED, never commit real values) ─────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_MFA_ENCRYPTION_KEY=
# Access token lifetime (seconds). Frontend holds it in memory only.
AUTH_ACCESS_TTL_SECONDS=900
# Refresh token lifetimes: remember=true → days, otherwise hours.
AUTH_REFRESH_REMEMBER_DAYS=30
AUTH_REFRESH_SESSION_HOURS=12
AUTH_EMAIL_VERIFICATION_HOURS=24
AUTH_PASSWORD_RESET_MINUTES=30
AUTH_MFA_CHALLENGE_MINUTES=5
AUTH_REAUTH_MINUTES=5
# Public web origin used to build email links (verify-email, reset-password).
# Local development may use HTTP; production MUST use an HTTPS origin.
WEB_APP_URL=http://localhost:3000
EMAIL_FROM=Euforia <your-account@gmail.com>
# Gmail SMTP: enable Google 2-Step Verification, then create an App Password.
# Production requires BOTH SMTP_USER and SMTP_APP_PASSWORD; never use the Google account password.
# Use the same Gmail address for SMTP_USER and EMAIL_FROM, or a Gmail-approved alias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=your-account@gmail.com
# SMTP_APP_PASSWORD=your-16-character-google-app-password
# Pauses email verification requirement for simple local login (default: true)
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# ── Calendar / Economic events (Phase 13) ────────────────────────────────────
# Past half of the canonical eco sync window in days (Analytics correlation
# depth; the reference engine ships -92 days).
# CALENDAR_WINDOW_PAST_DAYS=92
# Future half of the canonical eco sync window in days (planner banner /
# news-blocker horizon; the reference engine ships +13 days).
# CALENDAR_WINDOW_FUTURE_DAYS=13

# ── Integrations Hub (Phase 14 — REQUIRED) ───────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AES-256-GCM key encrypting webhook signing secrets at rest (own key — never
# the accounts credentials key nor the identity MFA key).
INTEGRATIONS_WEBHOOK_ENCRYPTION_KEY=

# ── Accounts / Trading Connectivity (Phase 3 — REQUIRED) ────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AES-256-GCM key encrypting trading provider credentials at rest (never committed).
ACCOUNTS_CREDENTIALS_ENCRYPTION_KEY=
# Per-call timeout for trading provider adapter calls (milliseconds).
ACCOUNTS_PROVIDER_TIMEOUT_MS=10000
# Mock trading provider gate (§57): "enabled" | "disabled".
# Defaults to enabled only in test; development/production require explicit opt-in.
# ACCOUNTS_MOCK_PROVIDER=enabled

# ── Real trading providers (§57 — NEVER enabled by default) ─────────────────
# Phase 03 — OANDA v20 REST adapter: "enabled" | "disabled" (opt-in per
# deployment). # ACCOUNTS_OANDA_PROVIDER=enabled
# REST base-URL override (tests/fixture server, region edge). Leave unset to
# route by environment: DEMO → api-fxpractice.oanda.com, LIVE → api-fxtrade.
# ACCOUNTS_OANDA_REST_URL=
# Phase 07 — Deriv WebSocket API adapter: "enabled" | "disabled" (opt-in).
# Requires: (1) an application registered on developers.deriv.com (PAT type);
# (2) each user creates a READ-SCOPE API token in the Deriv dashboard and
# pastes it at connect time (stored AES-256-GCM, never returned).
# ACCOUNTS_DERIV_PROVIDER=enabled
# Deriv application id from the developers.deriv.com dashboard. The default
# (1089) is Deriv's public EXAMPLE app id — development/verification ONLY;
# production deployments must register their own application.
# ACCOUNTS_DERIV_APP_ID=
# Deriv WS endpoint override (tests/fixture server). Official endpoint when
# unset: wss://ws.derivws.com/websockets/v3?app_id=<ACCOUNTS_DERIV_APP_ID>.
# ACCOUNTS_DERIV_WS_URL=

# ── Phase 08 — MT5 terminal bridge (read-only, opt-in) ───────────────────────
# Enables the shared MT5 terminal connector for supported broker accounts,
# including IC Markets, Axi and PU Prime where MT5 is available for the account.
# This is NOT a direct broker API and does not support MT4 or cTrader.
# Enable only when the Euforia API ingest endpoint is reachable from the user's
# MT5 terminal and the EuforiaBridge EA is installed in that terminal.
# ACCOUNTS_MT5_BRIDGE_PROVIDER=enabled

# ── Phase 05 — scheduled synchronization (opt-in, never default-on) ─────────
# ACCOUNTS_SYNC_SCHEDULER=enabled

# ── OCR / Screenshot Recognition (Phase 19) ──────────────────────────────────
# FastAPI OCR sidecar base URL (mini-services/ocr-service, :3004 in dev).
# When unset, no FastAPI engine is registered — recognition then requires the
# mock engine (OCR_MOCK_ENGINE) and production degrades to OCR_UNAVAILABLE.
# OCR_SERVICE_URL=http://127.0.0.1:3004
# Shared secret the API presents to the sidecar (REQUIRED when OCR_SERVICE_URL
# is set). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OCR_SERVICE_TOKEN=
# Mock OCR engine gate ("enabled" | "disabled") — enabled by default only in
# tests; development/production require explicit opt-in (§57 honesty).
# OCR_MOCK_ENGINE=enabled
# Max decoded binary size per screenshot upload (bytes, ≤ 8 MiB; the frontend
# data-URL contract caps at ~6 MB of binary). Requests beyond this are 413.
# OCR_UPLOAD_MAX_BYTES=6291456
# Decompression-bomb guard: max pixel count per image (§38).
# OCR_IMAGE_MAX_PIXELS=24000000
# Per-sidecar-call timeout (milliseconds).
# OCR_ENGINE_TIMEOUT_MS=30000
# Extra attempts for TRANSIENT engine failures (§34) on top of the first call.
# OCR_ENGINE_MAX_RETRIES=1

# ── Trading Core / Journal (Phase 4) ─────────────────────────────────────────
# Local filesystem storage root for trade-screenshot binaries (metadata-only
# rows in PostgreSQL; the adapter enforces path containment).
TRADES_SCREENSHOTS_ROOT=.data/trades-screenshots
# Max decoded binary size accepted for one trade screenshot (<= 8_000_000).
TRADES_SCREENSHOT_MAX_BYTES=6291456
# ── Tasky card attachments ────────────────────────────────────────────────
# Private server-side directory for Tasky files. Use a persistent volume in deployments.
TASKY_ATTACHMENTS_STORAGE_ROOT=.data/tasky-attachments
# Maximum raw file size (bytes), hard-capped at 5 MiB; supports image/PDF/text formats.
TASKY_ATTACHMENT_MAX_BYTES=5242880

# Local filesystem storage root for screenshot binaries (relative to apps/api
# when not absolute). Never committed; wiped by DELETE endpoints (§31).
# OCR_STORAGE_ROOT=.data/ocr-storage
