# COSMOZ API — environment template (copy to .env)
# NEVER commit real secrets. This file documents the validated contract.

# ── Application ──────────────────────────────────────────────────────────────
# test | development | production
NODE_ENV=development
# Port the API listens on (web .env.example suggests http://localhost:4000)
PORT=4000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local dev default: embedded dev database managed by `pnpm db:up` (port 5433).
# In production, supply a real connection string with credentials. The password
# MUST NOT be committed anywhere.
DATABASE_URL=postgresql://cosmoz@127.0.0.1:5433/cosmoz

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of origins. In production this variable is
# REQUIRED and "*" is rejected. Development default: the Next.js dev server.
# Multiple origins example: http://localhost:3000,https://app.cosmoz.app
CORS_ORIGINS=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug

# ── Security / requests ──────────────────────────────────────────────────────
# Max JSON body size in bytes (default 1 MiB).
BODY_LIMIT_BYTES=1048576
# Set true ONLY when the API runs behind a trusted reverse proxy, so rate
# limiting and client IPs use X-Forwarded-For instead of the proxy address.
TRUST_PROXY=false

# ── Rate limiting (global defaults — policies are refined per route later) ──
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120

# ── External services (optional — not wired in Foundation) ──────────────────
# Market data sidecar (Bun service on :3003 in dev). Format-validated when set.
# MARKET_SERVICE_URL=http://localhost:3003

# ── Authentication (PLACEHOLDER — Phase 2 will validate these) ──────────────
# Deliberately NOT validated in Foundation: do not add real secrets here yet.
# AUTH_JWT_SECRET=
# AUTH_JWT_ACCESS_TTL_SECONDS=900

# ── Authentication (Identity phase — REQUIRED, never commit real values) ─────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_MFA_ENCRYPTION_KEY=
# Access token lifetime (seconds). Frontend holds it in memory only.
AUTH_ACCESS_TTL_SECONDS=900
# Refresh token lifetimes: remember=true → days, otherwise hours.
AUTH_REFRESH_REMEMBER_DAYS=30
AUTH_REFRESH_SESSION_HOURS=12
AUTH_EMAIL_VERIFICATION_HOURS=24
AUTH_PASSWORD_RESET_MINUTES=30
AUTH_MFA_CHALLENGE_MINUTES=5
AUTH_REAUTH_MINUTES=5
# Public web origin used to build email links (verify-email, reset-password).
WEB_APP_URL=http://localhost:3000
EMAIL_FROM=Cosmoz <no-reply@cosmoz.app>

# ── Accounts / Trading Connectivity (Phase 3 — REQUIRED) ────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AES-256-GCM key encrypting trading provider credentials at rest (never committed).
ACCOUNTS_CREDENTIALS_ENCRYPTION_KEY=
# Per-call timeout for trading provider adapter calls (milliseconds).
ACCOUNTS_PROVIDER_TIMEOUT_MS=10000
# Mock trading provider gate (§57): "enabled" | "disabled".
# Defaults to enabled in test/development and DISABLED in production.
# ACCOUNTS_MOCK_PROVIDER=enabled

# ── OCR / Screenshot Recognition (Phase 19) ──────────────────────────────────
# FastAPI OCR sidecar base URL (mini-services/ocr-service, :3004 in dev).
# When unset, no FastAPI engine is registered — recognition then requires the
# mock engine (OCR_MOCK_ENGINE) and production degrades to OCR_UNAVAILABLE.
# OCR_SERVICE_URL=http://127.0.0.1:3004
# Shared secret the API presents to the sidecar (REQUIRED when OCR_SERVICE_URL
# is set). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OCR_SERVICE_TOKEN=
# Mock OCR engine gate ("enabled" | "disabled") — enabled by default outside
# production; production must set a real OCR_SERVICE_URL (§57 honesty).
# OCR_MOCK_ENGINE=enabled
# Max decoded binary size per screenshot upload (bytes, ≤ 8 MiB; the frontend
# data-URL contract caps at ~6 MB of binary). Requests beyond this are 413.
# OCR_UPLOAD_MAX_BYTES=6291456
# Decompression-bomb guard: max pixel count per image (§38).
# OCR_IMAGE_MAX_PIXELS=24000000
# Per-sidecar-call timeout (milliseconds).
# OCR_ENGINE_TIMEOUT_MS=30000
# Extra attempts for TRANSIENT engine failures (§34) on top of the first call.
# OCR_ENGINE_MAX_RETRIES=1

# ── Trading Core / Journal (Phase 4) ─────────────────────────────────────────
# Local filesystem storage root for trade-screenshot binaries (metadata-only
# rows in PostgreSQL; the adapter enforces path containment).
TRADES_SCREENSHOTS_ROOT=.data/trades-screenshots
# Max decoded binary size accepted for one trade screenshot (<= 8_000_000).
TRADES_SCREENSHOT_MAX_BYTES=6291456
# Local filesystem storage root for screenshot binaries (relative to apps/api
# when not absolute). Never committed; wiped by DELETE endpoints (§31).
# OCR_STORAGE_ROOT=.data/ocr-storage
