/// 20261006090000_ocr_v3 — recognition groups (multi-screenshot fusion).
model OcrRecognitionGroup {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PROPOSED | ACTIVE | CONFIRMED | DISCARDED
  status          String   @default("PROPOSED")
  /// 2..8 job ids (uuid strings).
  memberJobIds    Json
  evidence        Json?
  /// 0..100 — evidence-weighted fusion confidence.
  fusionConfidence Float   @default(0) @db.DoublePrecision
  autoConfirmed   Boolean  @default(false)
  fusedDraft      Json?
  /// Wire key → winning jobId.
  fieldOrigins    Json?
  conflicts       Json?
  timeline        Json?
  quality         Json?
  importedTradeId String?  @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

/// 20261006090000_ocr_v3 — asset-based collections (organization only).
model OcrCollectionAsset {
  collectionId String    @db.Uuid
  collection   OcrCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  assetId      String    @db.Uuid
  asset        OcrAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  addedAt      DateTime      @default(now())

  @@id([collectionId, assetId])
  @@index([assetId])
}

/// 20261006120000_ocr_v2 — the corrections memory (suggestions feed).
model OcrCorrection {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @db.Uuid
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  field            String
  platform         String
  rawValue         String?
  correctedValue   String
  useCount         Int     @default(1)
  lastRecognitionId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, field, rawValue, correctedValue])
  @@index([userId, updatedAt(sort: Desc)])
}

/// 20261006120000_ocr_v2 — the recognition event ledger (funnel/analytics).
model OcrEvent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  recognitionId String?  @db.Uuid
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([userId, type, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

/// Phase 10 → serveur — the Oryon chart analysis (multi-device journal).
/// Mirrors the shared oryonChartAnalysisSchema 1:1; the tradeId link is the
/// CANONICAL journal trade (never copied, never mutated by this domain).
model OryonAnalysis {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  /// Market interval (shared marketIntervalSchema vocabulary).
  interval     String
  /// Oryon chart type (oryonLayoutChartTypeSchema vocabulary).
  chartType    String
  title        String
  notes        String?
  /// Optional link to the canonical journal trade — ON DELETE SET NULL: the
  /// analysis survives a trade delete with the link honestly cleared.
  tradeId      String? @db.Uuid
  trade        Trade?  @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  /// Snapshot reference {tradeId, screenshotId, capturedAt} — points at the
  /// journal attachment, never owns a copy of the image.
  snapshot     Json?
  /// Panel analysis config (structure/levels) — validated by the shared schema.
  analysis     Json
  /// Restored drawings (oryonDrawingSchema[]).
  drawings     Json
  /// Last candle open time (unix SECONDS) of the analyzed chart state.
  referenceTimeSec BigInt?
  schemaVersion Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysisPlans AnalysisPlan[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, symbol])
}

/// Phase 11 — the Trade Plan (documented market reasoning). Distinct from the
/// Phase-5 risk-engine TradePlan: this is the thesis/scenarios/review record.
/// Lifecycle: DRAFT → ACTIVE → (INVALIDATED | COMPLETED) → ARCHIVED.
enum AnalysisPlanStatus {
  DRAFT
  ACTIVE
  INVALIDATED
  COMPLETED
  ARCHIVED
}

model AnalysisPlan {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       AnalysisPlanStatus @default(DRAFT)
  symbol       String
  timeframe    String?
  title        String
  /// The thesis — what the user expected to happen, in their own words.
  thesis       String
  /// Optional canonical journal trade link (ownership validated server-side).
  tradeId      String?           @db.Uuid
  trade        Trade?            @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  /// Optional Oryon chart-analysis reference (Phase 10 integration).
  analysisId   String?           @db.Uuid
  analysis     OryonAnalysis?    @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  /// What would falsify the thesis (user-defined, never auto-evaluated).
  invalidationCriteria String?
  invalidatedAt  DateTime?
  invalidationReason String?
  /// Post-trade review — process-focused, never a P&L judgment.
  reviewNotes  String?
  /// Optional process tags (followed_plan | deviated | invalidated | not_executed | insufficient_evidence).
  processTags  Json?
  reviewedAt   DateTime?
  completedAt  DateTime?
  /// Hypothetical levels — explicitly SEPARATE from actual execution facts.
  plannedEntry  Decimal? @db.Decimal(18, 8)
  plannedStop   Decimal? @db.Decimal(18, 8)
  /// Array of decimal-string targets.
  plannedTargets Json?
  /// Chart reference time (unix SECONDS) when the plan was written.
  referenceTimeSec BigInt?
  /// Alternative scenarios (validated nested schema — stable ids).
  scenarios    Json?
  schemaVersion Int      @default(1)
  /// Optimistic client idempotency — a double submit collapses to one row.
  clientRequestId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clientRequestId])
  @@index([userId, status])
  @@index([userId, symbol])
  @@index([tradeId])
}
