// COSMOZ — Prisma schema
//
// Phase 1 mandate (§9/§37): the Foundation establishes DATABASE INFRASTRUCTURE
// ONLY — client lifecycle, connectivity, migrations conventions, health.
// Business models (Trade, Strategy, …) are created by their own bounded
// contexts in later phases, following docs/specs/data-model.md as the design
// source and the migration order drafted there.
//
// Phase 2 (Identity & Security): User, Session, SecurityEvent, LoginRecord,
// AuthChallenge, RecoveryCode, ApiKey — per docs/specs/data-model.md Domaine 1
// refined by the shared contract (schemas/auth.ts, schemas/security.ts).
//
// Phase 3 (Accounts / Trading Connectivity): TradingAccount,
// TradingConnection, TradingAccountSnapshot, TradingPosition, TradingOrder,
// TradingDeal, TradingSyncRun — per docs/specs/data-model.md Domaine 2 and
// the Phase 3 mandate (§3 concepts kept separate, §15 lifecycles orthogonal,
// §18 stable external identity, §22 credentials encrypted at rest).
//
// Phase 19 (OCR / Screenshot Recognition): OcrAsset, OcrRecognition — the
// recognition bounded context. PostgreSQL stores METADATA + the recognition
// aggregate only; the actual image binary lives in the OCR storage adapter
// (local filesystem in this build), referenced by storageKey (§6). The
// canonical Trade remains owned by Trading Core — OCR never writes to any
// Trade table (§22/§42).
//
// Phase 4 (Trading Core & Trade Journal Foundation): Instrument, Trade,
// TradeExit, TradeEvent, TradeScreenshot — per docs/specs/data-model.md
// Domaine 3 and the Phase 4 mandate (§5 canonical journal trade ≠ broker
// position ≠ deal, §6 multiple executions per trade, §7 Cosmoz-owned
// identity, §8 explicit source, §9 external mapping, §15/§46 Decimal
// money, §46 single authoritative P&L implementation). Deliberately NOT
// created: TradeExecution (the broker executions ARE Phase 3's TradingDeal
// rows — duplicating them would violate §3/ADR-0003) and
// ExternalTradeMapping (Trade.externalPositionId + its composite unique
// carries the mapping). strategyId/setupId are OPAQUE uuid references —
// the Playbook domain arrives in a later phase and will attach the FKs.
// TradingDeal gained "positionId" (nullable) so the deal→trade
// reconstruction (§17/§26) can group executions the way MT5 netting does.
//
// CONVENTIONS (binding for all future migrations):
//   - Money/prices/quantities/R → Decimal(18,8) columns, string wire format.
//   - All timestamps stored UTC; user timezone lives on the User model.
//   - Migrations are deterministic, versioned, reviewable; created with
//     `pnpm db:migrate -- --name <descriptive_name>`; applied non-interactively
//     with `prisma migrate deploy`. Never reset a non-test database.
//   - Seeding is done by migration tooling only (never hand INSERTs).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
}

enum AuthRole {
  TRADER
  ADMIN
}

// ── Identity (Domaine 1 — data-model.md) ─────────────────────────────────────

model User {
  id                    String        @id @default(uuid()) @db.Uuid
  email                 String        @unique
  name                  String
  passwordHash          String
  status                AccountStatus @default(PENDING_VERIFICATION)
  role                  AuthRole      @default(TRADER)
  emailVerifiedAt       DateTime?
  passwordLastChangedAt DateTime      @default(now())

  // MFA / TOTP — secrets are AES-256-GCM encrypted at rest, never plaintext.
  mfaSecretEnc        String?
  mfaPendingSecretEnc String?
  mfaEnabledAt        DateTime?
  mfaDisabledAt       DateTime?
  mfaLastVerifiedAt   DateTime?

  // Profile (shared profileSchema — one source of truth for timezone).
  timezone     String  @default("UTC")
  baseCurrency String  @default("USD")
  username     String? @unique
  bio          String?
  avatarUrl    String?

  // UserPreferences doc (shared userPreferencesSchema, JSON per user).
  preferences Json?

  // Account deletion is SCHEDULED (grace period) — purge job is a later phase.
  deletionScheduledFor DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          Session[]
  securityEvents    SecurityEvent[]
  loginRecords      LoginRecord[]
  challenges        AuthChallenge[]
  recoveryCodes     RecoveryCode[]
  apiKeys           ApiKey[]
  tradingAccounts   TradingAccount[]
  monitoringSetting MonitoringSetting?
  ocrAssets         OcrAsset[]
  ocrRecognitions   OcrRecognition[]
  ocrCorrectionPatterns OcrCorrectionPattern[]
  trades            Trade[]
  savedTradeViews   SavedTradeView[]
  disciplineRows    DisciplineRow[]
  tradeSubRows      TradeSubRow[]
  sessionNoteRows   SessionNoteRow[]
  skippedTradeRows  SkippedTradeRow[]
  calendarBlockRows CalendarBlockRow[]
  reviewRows        ReviewRow[]
  sessionLiveRows   SessionLiveRow[]
  playbookRows      PlaybookRow[]
  nofyRows          NofyRow[]
  academyRows       AcademyRow[]
  integrationRows   IntegrationRow[]
  tagRows           TagRow[]

  @@index([status])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the presented refresh token — never the raw token.
  refreshTokenHash  String    @unique
  /// The hash rotated AWAY in the last rotation — presenting it is REUSE.
  previousTokenHash String?
  /// Rotation generation — presenting a lower generation is REUSE.
  generation        Int       @default(1)
  device            String    @default("Unknown device")
  browser           String    @default("Unknown")
  os                String    @default("Unknown")
  /// Masked at creation — full addresses never stored, never returned (§11).
  ipMasked          String    @default("unknown")
  location          String    @default("Unknown")
  userAgent         String?
  createdAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
}

/// Append-only security event log — no endpoint may update or delete rows.
model SecurityEvent {
  id      String   @id @default(uuid()) @db.Uuid
  userId  String?  @db.Uuid
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  at      DateTime @default(now())
  type    String
  /// Who performed it — the user, a session id, or "system".
  actor   String
  /// Sanitized human context — never contains secret material.
  context String
  outcome String   @default("SUCCESS")

  @@index([userId, at(sort: Desc)])
}

model LoginRecord {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  at       DateTime @default(now())
  success  Boolean
  device   String
  browser  String
  os       String
  ipMasked String
  location String
  /// Failure reason only — sanitized, no secret material.
  reason   String?

  @@index([userId, at(sort: Desc)])
}

/// Single-use, purpose-scoped one-time tokens (email verification, password
/// reset). Only the SHA-256 hash is stored — never the raw token.
model AuthChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// EMAIL_VERIFICATION | PASSWORD_RESET — cross-purpose use is impossible.
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  /// Activation happens at 2FA confirm; regeneration replaces the whole set.
  active    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, active])
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// Recognizable prefix only — the secret is discarded after creation.
  prefix      String
  /// Short SHA-256 fingerprint so users can recognize the key later.
  fingerprint String
  secretHash  String    @unique
  scopes      String[]
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?

  @@index([userId])
}

// ── Monitoring (Phase 17 — operational observability) ─────────────────────

/// Per-user Monitoring configuration — the ONLY persisted Monitoring entity.
/// Metrics, system events, alerts and health are DERIVED from bounded
/// in-memory windows at read time (§40/§45: no metrics warehouse inside
/// PostgreSQL; no homemade time-series store). Thresholds persist because
/// the user configures them explicitly (PATCH /monitoring/thresholds) and
/// they must survive process restarts.
model MonitoringSetting {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// monitoringThresholdsSchema JSON (shared contract — freshness knobs +
  /// the 8 alert rules with their enabled flag and numeric knob).
  data      Json
  updatedAt DateTime @updatedAt
}

// ── Accounts / Trading Connectivity (Domaine 2 — Phase 3) ────────────────────

/// An EXTERNAL trading account (broker/platform identity) owned by a Cosmoz
/// user. Identity is stable metadata — mutable state lives in the snapshot
/// and the normalized position/order/deal tables, never here (§25).
model TradingAccount {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Human label (defaults to "<provider> <environment>").
  name              String
  /// Explicit environment — DEMO | LIVE | PROP_FIRM. Never inferred from naming (§21).
  type              String
  /// Broker/platform family (Cosmoz broker enum, e.g. "MT5").
  broker            String
  /// Account currency as reported by the provider (validated against the shared currency enum).
  currency          String
  /// Provider-reported balance at initial connection (journal anchor).
  startingBalance   Decimal @db.Decimal(18, 8)
  /// The first account of a user is the default; otherwise a journal-only concern.
  isDefault         Boolean @default(false)
  /// Prop-firm challenge config (shared propFirmConfigSchema) — journal domain, null on connect.
  propConfig        Json?
  /// Provider-side account identifier (e.g. MT5 login). Unique per user+provider (§49 duplicates).
  externalAccountId String
  /// Provider registry key (e.g. "MOCK" — real adapters register their own).
  providerId        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection TradingConnection?
  snapshots  TradingAccountSnapshot[]
  positions  TradingPosition[]
  orders     TradingOrder[]
  deals      TradingDeal[]
  syncRuns   TradingSyncRun[]
  trades     Trade[]
  /// OCR recognitions attached to this account (engine quality §3.1) —
  /// the import target chosen by the user at upload/confirmation.
  ocrRecognitions OcrRecognition[]

  @@unique([userId, providerId, externalAccountId])
  @@index([userId])
}

/// HOW Cosmoz talks to the provider for one account — a separate entity from
/// both the account (identity) and its snapshots (state) (§3).
/// 1:1 with the account; disconnect wipes credentials but keeps the row (§52).
model TradingConnection {
  id              String         @id @default(uuid()) @db.Uuid
  accountId       String         @unique @db.Uuid
  account         TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Provider registry key (denormalized from the account for direct lookups).
  providerId      String
  /// API_KEY in V1 (shared tradingConnectionMethodSchema).
  method          String
  /// DISCONNECTED | CONNECTING | CONNECTED | ERROR (§15 — orthogonal to sync status).
  status          String         @default("DISCONNECTED")
  /// AES-256-GCM encrypted credentials — NEVER plaintext, never returned, never logged (§22).
  /// Wiped (empty) on disconnect.
  credentialsEnc  String         @default("")
  /// Masked hint (last characters only) for UI display — never enough to authenticate.
  credentialsHint String         @default("")
  /// Read-only permission set granted from the provider descriptor (§24).
  permissions     String[]
  /// Sanitized, credential-free provider failure text.
  lastError       String?
  lastConnectedAt DateTime?
  /// Last SUCCESSFUL synchronization completion (UTC).
  lastSyncAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId, status])
}

/// Mutable external state (balance/equity/margin) — the LATEST snapshot per
/// account (§25). The provider is the source of truth; this is a synchronized
/// representation (§46). Historical runs are observable via TradingSyncRun.
model TradingAccountSnapshot {
  id            String         @id @default(uuid()) @db.Uuid
  accountId     String         @unique @db.Uuid
  account       TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  balance       Decimal?       @db.Decimal(18, 8)
  equity        Decimal?       @db.Decimal(18, 8)
  /// Derived as equity − balance when both exist; null otherwise.
  unrealizedPnl Decimal?       @db.Decimal(18, 8)
  margin        Decimal?       @db.Decimal(18, 8)
  freeMargin    Decimal?       @db.Decimal(18, 8)
  marginLevel   Decimal?       @db.Decimal(18, 8)
  currency      String
  /// When the provider reported this state (UTC).
  syncedAt      DateTime
  /// Run that produced this snapshot (observability, §50).
  syncRunId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, syncedAt])
}

/// Open position, normalized from the provider (§26). Nullable fields are
/// preferred over false assumptions — providers differ.
model TradingPosition {
  id                 String         @id @default(uuid()) @db.Uuid
  accountId          String         @db.Uuid
  account            TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Stable external identity — idempotency key together with the account (§18).
  externalPositionId String
  symbol             String
  /// BUY | SELL (shared directionSchema).
  side               String
  volume             Decimal        @db.Decimal(18, 8)
  entryPrice         Decimal        @db.Decimal(18, 8)
  currentPrice       Decimal?       @db.Decimal(18, 8)
  stopLoss           Decimal?       @db.Decimal(18, 8)
  takeProfit         Decimal?       @db.Decimal(18, 8)
  /// Unrealized profit in account currency.
  profit             Decimal?       @db.Decimal(18, 8)
  swap               Decimal?       @db.Decimal(18, 8)
  commission         Decimal?       @db.Decimal(18, 8)
  /// When the position was opened according to the PROVIDER (UTC, §64).
  openedAt           DateTime
  /// When Cosmoz last refreshed this row from the provider (UTC).
  syncedAt           DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, externalPositionId])
  @@index([accountId, symbol])
}

/// Pending order, normalized read-only (§27). No execution path exists anywhere.
model TradingOrder {
  id                String         @id @default(uuid()) @db.Uuid
  accountId         String         @db.Uuid
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalOrderId   String
  symbol            String
  /// Broker verb, e.g. "BUY_LIMIT", "SELL_STOP" (provider vocabulary, read-only).
  type              String
  volume            Decimal        @db.Decimal(18, 8)
  price             Decimal        @db.Decimal(18, 8)
  stopLoss          Decimal?       @db.Decimal(18, 8)
  takeProfit        Decimal?       @db.Decimal(18, 8)
  /// Provider order status vocabulary.
  status            String
  /// Provider-side timestamps (UTC, §64).
  providerCreatedAt DateTime?
  providerUpdatedAt DateTime?
  syncedAt          DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, externalOrderId])
  @@index([accountId, status])
}

/// Completed trading activity (deals), normalized (§28). Symbol is nullable:
/// balance operations (deposits/withdrawals) have no instrument.
model TradingDeal {
  id             String         @id @default(uuid()) @db.Uuid
  accountId      String         @db.Uuid
  account        TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalDealId String
  symbol         String?
  /// BUY | SELL.
  side           String
  volume         Decimal        @db.Decimal(18, 8)
  price          Decimal?       @db.Decimal(18, 8)
  profit         Decimal?       @db.Decimal(18, 8)
  commission     Decimal?       @db.Decimal(18, 8)
  swap           Decimal?       @db.Decimal(18, 8)
  /// Provider-side position this deal belongs to (MT5 netting semantics) —
  /// the Trading Core reconstruction groups on it (Phase 4 §9/§17).
  /// Null = balance operation (deposits/withdrawals have no instrument).
  positionId     String?
  /// Provider-side execution timestamp (UTC, §64).
  executedAt     DateTime
  syncedAt       DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, externalDealId])
  @@index([accountId, executedAt])
  @@index([accountId, positionId])
}

/// One synchronization attempt over one account — observability + concurrency
/// guard (§38/§50). At most ONE RUNNING run per account (partial unique index
/// added in the migration — Prisma cannot express partial indexes).
model TradingSyncRun {
  id                String         @id @default(uuid()) @db.Uuid
  accountId         String         @db.Uuid
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status            String         @default("RUNNING")
  /// INITIAL | MANUAL.
  trigger           String
  startedAt         DateTime       @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  positionsUpserted Int            @default(0)
  ordersUpserted    Int            @default(0)
  dealsUpserted     Int            @default(0)
  /// Stable normalized error code — never a raw provider message, never a secret.
  errorCode         String?
  /// Request correlation id (§50).
  requestId         String?

  @@index([accountId, startedAt(sort: Desc)])
}

// ── OCR / Screenshot Recognition (Phase 19) ─────────────────────────────────

/// Metadata for one uploaded screenshot — the DB never stores the binary
/// (§6: PostgreSQL = metadata + storage reference, storage adapter = bytes).
/// One row per distinct image per user: the checksum is the dedup anchor and
/// the idempotency input (§32), so re-uploading the same screenshot never
/// duplicates stored bytes.
model OcrAsset {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Storage-adapter reference — validated to stay inside the storage root;
  /// never a raw filesystem path, never client-controlled (§7).
  storageKey     String   @unique
  /// Sanitized display name — the original filename is NEVER used for
  /// storage paths (path-traversal prevention, §7).
  originalName   String
  /// MIME determined by MAGIC-BYTE sniffing — never the client Content-Type (§7).
  mime           String
  sizeBytes      Int
  width          Int
  height         Int
  /// SHA-256 of the decoded binary — identity + integrity anchor (§6).
  checksumSha256 String
  /// 64-bit dHash perceptual fingerprint (hex, engine quality §2.1) —
  /// near-duplicate detection across the user's uploads. Nullable for rows
  /// created before this phase.
  phashHex String?
  createdAt      DateTime @default(now())

  recognitions OcrRecognition[]

  /// One stored binary per distinct image per user (§32 idempotency input).
  @@unique([userId, checksumSha256])
  @@index([userId, createdAt(sort: Desc)])
}

/// One recognition request over one asset — the full job lifecycle (§24) and
/// the human-in-the-loop aggregate (§21). The machine result is untrusted
/// data (§1): it stays a JSON extraction payload, while user corrections are
/// the ONLY authoritative values and can never be overwritten by the engine.
model OcrRecognition {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId           String   @db.Uuid
  asset             OcrAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// QUEUED | PROCESSING | REVIEW_REQUIRED | FAILED | CONFIRMED (§24 states
  /// that actually exist — guarded transitions enforced in the repository).
  status            String   @default("QUEUED")
  /// TRADE_SUMMARY in V1 (shared ocrExtractionProfileSchema).
  extractionProfile String
  /// Pipeline version that produced/last touched the result (§33).
  pipelineVersion   String
  /// Deterministic idempotency input: sha256(userId + checksum + profile +
  /// pipelineVersion) — re-submitting the same screenshot for the same
  /// pipeline version returns the existing recognition (§32).
  idempotencyKey    String

  /// Machine result payload {classification, fields, warnings, engine,
  /// durationMs} — untrusted engine output AFTER strict validation (§54).
  result               Json?
  /// Stable failure category (shared ocrFailureCategorySchema) + sanitized
  /// message — never raw engine output, never secrets (§35/§36).
  failureCategory      String?
  failureMessage       String?
  /// Processing attempt counter — bounded retries only (§34).
  attempt              Int       @default(1)
  /// Correlation ids for observability (§57) — no image data, ever (§36).
  requestId            String?
  processingStartedAt  DateTime?
  processingFinishedAt DateTime?

  /// Authoritative user-confirmed values (field → value, §21). Written once
  /// by the confirmation endpoint inside a transaction (§50); the engine can
  /// never write here.
  corrections Json?
  confirmedAt DateTime?

  /// Phase 21 — the canonical Trade created from the confirmed values through
  /// Trading Core (the ONLY sanctioned OCR→Trade path, §77). Null while
  /// unconfirmed and when the confirmed values could not resolve into a
  /// complete trade. ON DELETE SET NULL: the journal trade is authoritative
  /// and must survive a recognition delete (one-way provenance).
  tradeId String? @db.Uuid
  trade   Trade?  @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  /// Grouped confirmation (engine quality §2.2): every Trade imported from
  /// the multi-trade drafts, as a JSON array of uuids (tradeId above stays
  /// the FIRST/primary one). Written only by the confirmation bridge.
  tradeIds Json?

  /// ACCOUNTS attachment (engine quality §3.1): the trading account chosen
  /// for the import — set at upload or confirmation; the bridge prefers it
  /// over the persisted default. ON DELETE SET NULL: deleting the account
  /// keeps the recognition record.
  accountId String? @db.Uuid
  account   TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// Retention (engine quality §4.2): when the stored screenshot binary was
  /// purged. Metadata rows remain (idempotency, history, analytics) — the
  /// image endpoint answers 404 once purged.
  screenshotPurgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Idempotency: one recognition per (user, image, profile, pipeline) (§32).
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([tradeId])
  @@index([accountId])
}

/// Corrections memory (engine quality §2.3): one row per (field, raw
/// reading → user correction) pair, with a hit counter. Feeds the
/// pre-suggestion hints on future recognitions of the SAME user — advisory
/// only, never applied automatically (§21 human-in-the-loop).
model OcrCorrectionPattern {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldKey       String
  /// The machine rawValue exactly as it was read (the memory key).
  rawValue       String
  /// The user's validated declaration (canonical stored form, §21).
  correctedValue String
  /// How many times this correction repeated (recurrence = confidence).
  count          Int      @default(1)
  lastSeenAt     DateTime

  @@unique([userId, fieldKey, rawValue, correctedValue])
  @@index([userId, fieldKey, rawValue])
}

// ── Trading Core / Journal (Domaine 3 — Phase 4) ───────────────────────────

/// Instrument catalog (Domaine 2). Specs live per instrument (pipSize,
/// contractSize, digits) — NO per-asset-class constants in code (synthetic
/// indices ≠ forex lots). Seeded by migration tooling only (conventions).
model Instrument {
  id            String  @id @default(uuid()) @db.Uuid
  /// Unique ticker, e.g. "EURUSD", "BOOM500", "VOL75(1s)".
  symbol        String  @unique
  name          String
  /// FOREX | CRYPTO | SYNTHETIC | INDEX | METAL | ENERGY (shared assetClassSchema).
  assetClass    String
  quoteCurrency String
  /// Price increment of one pip, e.g. "0.0001" forex, "1.0" Boom/Crash.
  pipSize       Decimal @db.Decimal(18, 8)
  /// Display digits for prices.
  digits        Int
  /// Units per lot/contract, e.g. "100000" EURUSD, "1" synthetics/crypto.
  contractSize  Decimal @db.Decimal(18, 8)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())

  trades Trade[]
}

/// The CANONICAL journal trade (Phase 4 §5): a journal-level business object
/// reconstructed from/linked to external executions — never a mirror of a
/// broker position or deal (§1). The PLAN is kept separate from REALITY and
/// from RESULTS (server-computed, §15/§46). Soft delete only (§57).
model Trade {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String         @db.Uuid
  account         TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrumentId    String         @db.Uuid
  instrument      Instrument     @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  /// Opaque playbook reference in V1 — the Playbook domain (later phase)
  /// attaches the FK. Null = out-of-playbook trade (valuable to track).
  strategyId      String?        @db.Uuid
  setupId         String?        @db.Uuid
  /// Definition version frozen at entry.
  strategyVersion Int?
  /// PLANNED | OPEN | CLOSED | CANCELLED (shared tradeStatusSchema).
  status          String         @default("OPEN")
  /// BUY | SELL (shared directionSchema).
  direction       String
  /// MANUAL | IMPORT | EXTERNAL_SYNC (shared tradeSourceSchema, §8).
  source          String         @default("MANUAL")

  // ── THE PLAN (decided BEFORE) ──
  entryPrice  Decimal  @db.Decimal(18, 8)
  entryAt     DateTime
  quantity    Decimal  @db.Decimal(18, 8)
  initialStop Decimal? @db.Decimal(18, 8)
  initialTP   Decimal? @db.Decimal(18, 8)
  plannedRR   Decimal? @db.Decimal(18, 8)
  /// Money risked at entry, in account currency.
  riskAmount  Decimal? @db.Decimal(18, 8)

  // ── REALITY (what happened) ──
  /// Stop at exit time; ≠ initialStop → stop was moved (see TradeEvent).
  finalStop  Decimal?  @db.Decimal(18, 8)
  exitPrice  Decimal?  @db.Decimal(18, 8)
  exitAt     DateTime?
  /// TP | SL | MANUAL | TRAILING | PARTIAL | MARGIN.
  exitReason String?
  fees       Decimal   @default(0) @db.Decimal(18, 8)
  swap       Decimal   @default(0) @db.Decimal(18, 8)

  // ── RESULTS (server-computed at close — the ONLY authority, §15/§46) ──
  pnlGross  Decimal? @db.Decimal(18, 8)
  pnlNet    Decimal? @db.Decimal(18, 8)
  rMultiple Decimal? @db.Decimal(18, 8)
  mfePrice  Decimal? @db.Decimal(18, 8)
  maePrice  Decimal? @db.Decimal(18, 8)
  mfeR      Decimal? @db.Decimal(18, 8)
  maeR      Decimal? @db.Decimal(18, 8)

  // ── PSYCHOLOGY (friction minimal: 1 tap) ──
  emotionBefore String?
  emotionAfter  String?
  /// 1–5.
  confidence    Int?

  // ── DECISION GATE / DISCIPLINE ──
  /// Grade submitted BEFORE the P&L reveal (A–F). Re-submission → 409.
  decisionGrade String?
  decisionAt    DateTime?
  /// Self-report (the feeling).
  followedPlan  Boolean?
  /// Checklist answers frozen at trade time.
  checklistSnap Json?

  // ── CONTEXT ──
  notes         String?
  lessons       String?
  /// User-local trading day — server-computed via the user timezone (§56).
  tradingDate   DateTime @db.Date
  /// Broker-side trade ref → CSV/import idempotence.
  externalRef   String?
  importBatchId String?  @db.Uuid

  /// External mapping (§9/§44): one broker position = one journal trade.
  /// Null for MANUAL/IMPORT trades. Repeated syncs upsert on it (§27).
  externalPositionId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete (undo possible, §57) — synchronized history is never
  /// hard-deleted.
  deletedAt DateTime?

  exits           TradeExit[]
  events          TradeEvent[]
  screenshots     TradeScreenshot[]
  /// Phase 21 — recognitions whose CONFIRMED values produced this trade
  /// through the OCR bridge (§77). One-way provenance: the trade never
  /// depends on the recognition, and deleting the recognition keeps the trade.
  ocrRecognitions OcrRecognition[]

  /// Import idempotence (§27): one broker ref per account. PostgreSQL allows
  /// several (account, NULL) rows — MANUAL trades stay unconstrained.
  @@unique([accountId, externalRef])
  /// One journal trade per broker position per account (§27 idempotency).
  @@unique([accountId, externalPositionId])
  @@index([userId, tradingDate])
  @@index([userId, status])
  @@index([accountId, status])
  @@index([userId, deletedAt])
}

/// One partial-exit leg of a journal trade. A simple trade uses
/// Trade.exitPrice directly; partial exits keep the execution relationship
/// (Phase 4 §18) without flattening history irreversibly (§19).
model TradeExit {
  id       String   @id @default(uuid()) @db.Uuid
  tradeId  String   @db.Uuid
  trade    Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  price    Decimal  @db.Decimal(18, 8)
  quantity Decimal  @db.Decimal(18, 8)
  exitedAt DateTime
  /// TP | SL | MANUAL | TRAILING | PARTIAL | MARGIN.
  reason   String
  note     String?

  createdAt DateTime @default(now())

  @@index([tradeId, exitedAt])
}

/// Lightweight event sourcing on a trade (§38/§40): the ONLY way to detect
/// "stop widened" — final state alone never tells the story. Server-forged:
/// no endpoint accepts a client-written TradeEvent.
model TradeEvent {
  id      String @id @default(uuid()) @db.Uuid
  tradeId String @db.Uuid
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  /// SL_MODIFIED | TP_MODIFIED | SIZE_MODIFIED | REOPENED | NOTE.
  type    String
  /// e.g. { "from": "1.0850", "to": "1.0800" }.
  payload Json
  /// USER | AUTO | IMPORT.
  source  String

  createdAt DateTime @default(now())

  @@index([tradeId, createdAt])
}

/// Chart evidence for a trade. PostgreSQL stores METADATA + the storage
/// reference; the binary lives in the Trading Core storage adapter (§39:
/// raw payloads isolated, restricted, never the domain model).
model TradeScreenshot {
  id             String  @id @default(uuid()) @db.Uuid
  tradeId        String  @db.Uuid
  trade          Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  /// BEFORE | AFTER | CHART | OTHER.
  kind           String
  /// Storage-adapter reference — validated, never client-controlled.
  storageKey     String
  /// SHA-256 of the stored binary (integrity + dedup anchor).
  checksumSha256 String
  /// MIME determined by MAGIC-BYTE sniffing — never the client header.
  mime           String
  sizeBytes      Int
  caption        String?
  /// User-drawn arrows/zones.
  annotations    Json?

  createdAt DateTime @default(now())

  @@index([tradeId, createdAt])
}

/// Named, reusable (filters + columns + sort) snapshot — one unified preset
/// library shared by the Trades ledger (TRADES scope) and the Analytics
/// module (ANALYTICS scope), per the shared savedTradeViewSchema contract.
model SavedTradeView {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  /// TRADES | ANALYTICS.
  scope            String   @default("TRADES")
  /// savedTradeViewFiltersSchema JSON (mirrors the trades URL param bag).
  filters          Json
  /// analyticsViewFiltersSchema JSON — ANALYTICS-scope presets only.
  analyticsFilters Json?
  /// Visible ledger columns (checkbox/actions columns are structural).
  columns          String[]
  /// date | r | pnl.
  sortKey          String
  /// asc | desc.
  sortDir          String

  createdAt DateTime @default(now())

  /// View names are unique per user (case-insensitive check at the service
  /// boundary; the DB constraint is the backstop).
  @@unique([userId, name])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════════════════
// Module-upgrade bounded contexts (backend parity build) — one table per
// domain, following the MonitoringSetting precedent: the row identity lives
// in columns (userId, kind, tradeId…), the domain aggregate lives in `data`
// as the shared-contract JSON. No cross-context joins: each context owns its
// table and maps rows to its shared schemas inside its own repository.
// ════════════════════════════════════════════════════════════════════════════

/// Discipline context — rules, violations, emotion entries, daily ledger.
model DisciplineRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// RULE | VIOLATION | ALERT | EMOTION
  kind      String
  /// Shared-contract JSON (ruleSchema / disciplineViolationSchema / alertSchema / …).
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
}

/// Trade sub-resources owned by other contexts — mistake links, trade↔tag
/// joins, session series snapshots (kept OUT of the Trade table: no
/// bounded-context leaks).
model TradeSubRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeId   String   @db.Uuid
  /// MISTAKE | TAG | SESSION_SERIES
  kind      String
  /// Shared-contract JSON for the sub-resource.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, tradeId, kind])
}

/// Journal context — session notes (the /session/notes CRUD).
model SessionNoteRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Shared-contract JSON (sessionNoteSchema).
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Ghost context — skipped trades awaiting settlement + settled history.
model SkippedTradeRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Shared-contract JSON (skippedTradeSchema).
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Calendar context — calendar blocks (imported eco events + manual blocks).
model CalendarBlockRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO date key the block lands on (yyyy-mm-dd, user timezone).
  date      String
  /// Shared-contract JSON (calendarBlockSchema).
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

/// Trade Review context — per-trade reviews, lessons and goals.
model ReviewRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// REVIEW | GOAL | LESSON — reviews additionally carry tradeId.
  kind      String
  tradeId   String?  @db.Uuid
  /// Shared-contract JSON (tradeReviewSchema / goalSchema / lessonSchema).
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
}

/// Session Live context — trading sessions, saved analyses, key levels.
model SessionLiveRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SESSION | ANALYSIS | LEVEL
  kind      String
  /// Shared-contract JSON (sessionLiveSessionSchema / analysis / keyLevel).
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
}

/// Playbook context — setups, rules, templates, checklists, versions.
model PlaybookRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SETUP | RULE | TEMPLATE | CHECKLIST | VERSION
  kind      String
  /// Shared-contract JSON for the sub-resource.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
}

/// Nofy context — knowledge notes, folders, tags, templates, versions.
model NofyRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NOTE | FOLDER | TAG | TEMPLATE | VERSION
  kind      String
  /// Shared-contract JSON (nofyNoteSchema / folder / tag / template).
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
}

/// Academy context — per-user progress, event registrations, Tasky tasks.
model AcademyRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PROGRESS | EVENT_REGISTRATION | TASK
  kind      String
  /// Shared-contract JSON for the sub-resource.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
}

/// Journal context — user-owned tag catalog (data-model.md "Domaine 4": free,
/// hierarchical tags; the system starter set is lazily seeded on first read).
model TagRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Shared-contract tag payload MINUS id/userId (the row id IS the tag id):
  /// { name, category, color, parentId }.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Integration Hub context — per-user provider connections, webhook endpoints,
/// audit event log, error ledger, normalized eco events and sample news.
/// The provider REGISTRY (12 catalog entries with capabilities/licensing) is
/// static module content; these rows hold only per-user runtime state.
model IntegrationRow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PROVIDER | WEBHOOK | EVENT | ERROR | ECO | NEWS | SEEN
  kind      String
  /// providerId ("deriv") / webhook id ("wh-macro") / providerKey for ECO+SEEN.
  refId     String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
  @@unique([userId, kind, refId])
}
