/// 20261004100000_settings_preferences — the settings-owned preferences doc.
model UserSettings {
  userId      String @id @db.Uuid
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 20261003213149_integrations_platform — normalized integration hub.
model IntegrationConnection {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @db.Uuid
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId              String
  status                  IntegrationStatus  @default(DISCONNECTED)
  authState               IntegrationAuthState @default(MISSING)
  credentialsVaultRef     String?
  credentialsHint         String?
  credentialsLastRotatedAt DateTime?
  connectedAt             DateTime?
  lastCheckedAt           DateTime?
  syncLastAttemptedAt     DateTime?
  syncLastSuccessAt       DateTime?
  syncLastDurationMs      Int?
  syncRecordsProcessed    Int                @default(0)
  syncRecordsFailed       Int                @default(0)
  syncRetryCount          Int                @default(0)
  syncRunCount            Int                @default(0)
  syncCursor              String?
  syncNextRetryAt         DateTime?
  pairedOnce              Boolean            @default(false)
  scenario                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: no Prisma relations between the Integration* tables — every
  // repository query is (userId, providerId)-scoped directly, matching the
  // platform migration's plain FK-by-column design.

  @@unique([userId, providerId])
  @@index([userId, status])
}

model IntegrationEvent {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId   String
  providerName String
  type         IntegrationEventType
  message      String
  occurredAt   DateTime            @default(now())

  @@index([userId, occurredAt(sort: Desc)])
}

model IntegrationError {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId   String
  code         IntegrationErrorCode
  message      String
  retryable    Boolean
  actionHint   String
  retryAfterMs Int?
  occurredAt   DateTime             @default(now())
  clearedAt    DateTime?

  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, providerId, clearedAt])
}

model IntegrationWebhookEndpoint {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @db.Uuid
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId         String
  path               String
  status             WebhookEndpointStatus @default(ACTIVE)
  secretEnc          String
  secretHint         String
  lastAcceptedEventId String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  deliveries IntegrationWebhookDelivery[]

  @@unique([path])
  @@unique([userId, providerId])
}

model IntegrationWebhookDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  endpointId     String   @db.Uuid
  endpoint       IntegrationWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId        String
  eventType      String
  signatureValid Boolean
  accepted       Boolean
  duplicate      Boolean
  message        String
  receivedAt     DateTime @default(now())

  @@unique([endpointId, eventId])
  @@index([endpointId, receivedAt(sort: Desc)])
}

/// 20261003160138_playbook — the normalized playbook generation (Phase 7
/// surface reads these shapes; the wired B10 module keeps PlaybookRow).
model Strategy {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @db.Uuid
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String  @default("DRAFT")
  name        String
  description String
  entryRules  Json
  exitRules   Json
  riskRules   Json
  grade       String
  color       String
  version     Int     @default(1)
  tags        Json
  detailedDescription String?
  marketProfile Json?
  marketConditions Json?
  entryConditions  Json?
  confirmations    Json?
  invalidations    Json?
  risk             Json?
  tradeManagement  Json?
  exitPlan         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setups    Setup[]
  snapshots StrategyVersionSnapshot[]
  checklists ChecklistTemplate[]
  rules     PlaybookRule[]

  @@index([userId, status])
  @@index([userId, updatedAt(sort: Desc)])
}

model StrategyVersionSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  strategyId String   @db.Uuid
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  version    Int
  snapshot   Json
  reason     String?

  createdAt DateTime @default(now())

  @@unique([strategyId, version])
}

model Setup {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId  String   @db.Uuid
  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  name        String
  status      String   @default("ACTIVE")
  description String
  context     String?
  marketCondition String?
  trigger     String?
  confirmation String?
  entryModel  String?
  stopModel   String?
  targetModel String?
  invalidation String?
  notes       String?
  tags        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, strategyId])
}

model ChecklistTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId String?  @db.Uuid
  strategy   Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  name       String
  items      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlaybookRule {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  detail     String
  category   String
  scope      String
  strategyId String?  @db.Uuid
  strategy   Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  evaluatable Boolean @default(false)
  evaluationHint String?
  active     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
