{
  "name": "@cosmoz/api",
  "version": "0.1.0",
  "private": true,
  "description": "Cosmoz backend — NestJS DDD Modular Monolith (Foundation)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps --env-file-if-exists=.env dist/apps/api/src/main.js\"",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/apps/api/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "node scripts/dev-db.mjs up",
    "db:status": "node scripts/dev-db.mjs status",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.16.2",
    "decimal.js": "^10.4.3",
    "nestjs-pino": "^4.4.0",
    "otpauth": "^9.5.2",
    "pino": "^9.9.2",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.16.13",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "embedded-postgres": "17.5.0-beta.15",
    "eslint": "^9.36.0",
    "fastify": "5.11.3",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.16.2",
    "tsc-watch": "^7.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.4"
  }
}
